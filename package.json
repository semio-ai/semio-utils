{
  "name": "@semio/utils",
  "description": "Shared typescript utilities.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semio-ai/semio_studio.git",
    "directory": "packages/utils"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts src/index.ts --external react",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts src/index.ts --external react",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test:unit": "vitest run",
    "test": "vitest run"
  },
  "devDependencies": {
    "@semio/eslint-config": "*",
    "@semio/typescript-config": "*",
    "@types/color": "^3.0.6",
    "@types/deep-equal": "^1.0.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.170.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "color": "^4.2.3",
    "deep-equal": "^2.2.3",
    "fast-deep-equal": "^3.1.3",
    "immer": "^10.1.1",
    "react": "^19.1.0",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  }
}

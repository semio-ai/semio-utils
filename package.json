{
  "name": "@semio/utils",
  "description": "Shared typescript utilities.",
  "version": "0.6.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semio-ai/semio-utils.git"
  },
  "homepage": "https://github.com/semio-ai/semio-utils#readme",
  "bugs": "https://github.com/semio-ai/semio-utils/issues",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "files": [
    "dist/**",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts src/index.ts --external react",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts src/index.ts --external react",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test:unit": "vitest run",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "test:release": "node .github/tests/release-harness.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.4",
    "@types/color": "^3.0.6",
    "@types/deep-equal": "^1.0.4",
    "@types/react": "^19.1.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.11.0",
    "js-yaml": "^5.5.0",
    "prettier": "^3.3.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.59.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "color": "^4.2.3",
    "deep-equal": "^2.2.3",
    "react": "^19.1.0",
    "zustand": "^5.0.2"
  }
}
